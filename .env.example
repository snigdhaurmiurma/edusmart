# Database (defaults to local SQLite; set PostgreSQL URL for production)
DATABASE_URL=sqlite:///./edusmart.db

# JWT signing secret (replace with a long random string in production)
JWT_SECRET=change-me-to-a-secure-random-secret

# Optional external LLM keys (app works out-of-the-box with built-in Hybrid RAG if left blank)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated allowed CORS origins for local dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
